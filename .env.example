# development | production | test
COLDKEEPER_ENV=development

# Local development (task dev:api, task migrate): PostgreSQL from `task db:up` on localhost:5433.
# In Docker the URL is built from POSTGRES_* below by docker-compose.yml.
COLDKEEPER_DATABASE_URL=postgresql+asyncpg://coldkeeper:coldkeeper@localhost:5433/coldkeeper

# Public address of the web interface and of the ingest URL shown to device installers.
COLDKEEPER_PUBLIC_URL=http://localhost:8080
# Browser origins allowed to send changes (JSON list).
COLDKEEPER_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Telegram bot (empty = dry-run: notifications are recorded but not sent).
COLDKEEPER_TELEGRAM_BOT_TOKEN=
COLDKEEPER_TELEGRAM_BOT_USERNAME=

COLDKEEPER_LOG_LEVEL=INFO

# Docker Compose
POSTGRES_USER=coldkeeper
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=coldkeeper
POSTGRES_PORT=5433
HTTP_PORT=8080
# ":80" locally; a domain name on a VPS (Caddy obtains the TLS certificate).
SITE_ADDRESS=:80
# VPS where 80/443 belong to another web server: see README («VPS, где 80 и 443 уже заняты»).
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.behind-proxy.yml
# PROXY_BIND=127.0.0.1
